{
  "name": "paseo-seamless-claude-accounts",
  "version": "1.4.0",
  "description": "Switch Claude Code accounts in Paseo without restarting a single chat, with automatic failover when an account hits its limit",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude",
    "claude-code",
    "accounts",
    "rate-limit",
    "failover"
  ],
  "homepage": "https://github.com/ChoqueCastroLD/paseo-seamless-claude-accounts#readme",
  "bugs": {
    "url": "https://github.com/ChoqueCastroLD/paseo-seamless-claude-accounts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChoqueCastroLD/paseo-seamless-claude-accounts.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.4.3"
  }
}
